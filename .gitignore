# Node / TypeScript
node_modules/
dist/
*.tsbuildinfo

# Python (only if a Python provider or tool lands here)
__pycache__/
*.pyc
.venv/
venv/

# Recording output - every walkthrough is regenerable from its storyboard, and
# a single run is tens of MB. Never commit renders.
output/
recordings/
*.webm
*.mp4
*.mkv
*.wav
*.mp3

# One exception: the demo. It is not a render lying around, it is a deliverable
# - the first thing a stranger opening a public repo wants, and the only honest
# way to show what the tool produces. Its storyboard is committed beside it, so
# it stays regenerable.
#
# It is ~9 MB and git history is permanent, so RE-CUTS ACCUMULATE: replacing it
# does not reclaim the old copy. If the demo starts changing often, move it to a
# GitHub Release asset instead of adding a second and a third here.
!docs/demo/
!docs/demo/*.mp4
frames/

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# TTS caches (Piper voices are ~60 MB each; edge-tts writes nothing but keep the seam)
.tts-cache/
voices/

# Secrets and browser auth state - storage state files hold session cookies
.env
.env.*
!.env.example
*.storage-state.json
auth/

# Editors / OS
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db

# Coverage
coverage/
.nyc_output/

# Copied into the package root by server/scripts/prepack.mjs so the
# published tarball carries them - `files` cannot reach above the package
# root. Generated at pack time; the originals live at the repository root.
server/README.md
server/LICENSE
server/skill/
